    'title_name', '1st vs 2nd Half UP HC ripple Effect on UP Survival', ...
    'feature_labels', model_labels, ...
    'strata_var', 'subject_id');


model_covariates = {'second_half_non_ripple_HPC_MUA_sum','first_half_non_ripple_HPC_MUA_sum'}
